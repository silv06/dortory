{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/gateway.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/gateway?route=/api/:path*"
    },
    {
      "source": "/signin-with-chatgpt",
      "destination": "/api/gateway?route=/signin-with-chatgpt"
    },
    {
      "source": "/signout-with-chatgpt",
      "destination": "/api/gateway?route=/signout-with-chatgpt"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api/gateway?route=/auth/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ]
}
